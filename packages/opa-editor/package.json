{
  "name": "@develapp/opa-editor",
  "version": "0.1.0",
  "description": "Backstage frontend plugin — domain-scoped OPA Rego editor",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "scripts": {
    "build": "tsc --build",
    "test": "jest"
  },
  "dependencies": {
    "@develapp/opa-domain-contract": "^0.1.0",
    "@develapp/opa-domain-finops": "^0.1.0",
    "@mui/material": "^5.15.0"
  },
  "peerDependencies": {
    "@backstage/core-plugin-api": "^1.12.9",
    "@monaco-editor/react": "^4.6.0",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@backstage/core-plugin-api": "^1.12.9",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@monaco-editor/react": "^4.6.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.1.4",
    "typescript": "^5.5.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["<rootDir>/src/test-setup.ts"],
    "testMatch": [
      "<rootDir>/src/__tests__/**/*.test.ts",
      "<rootDir>/src/__tests__/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^@develapp/opa-domain-contract$": "<rootDir>/../domain-contract/src/index.ts",
      "^@develapp/opa-domain-finops$": "<rootDir>/../domain-finops/src/index.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
