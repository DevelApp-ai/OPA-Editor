{
  "name": "@develapp/opa-domain-finops",
  "version": "0.1.0",
  "description": "FinOps FOCUS domain package for the OPA Rego editor",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "scripts": {
    "build": "tsc --build && mkdir -p dist/schemas && cp src/schemas/*.json dist/schemas/",
    "test": "jest"
  },
  "dependencies": {
    "@develapp/opa-domain-contract": "^0.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.5.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["<rootDir>/src/__tests__/**/*.test.ts"],
    "moduleNameMapper": {
      "^@develapp/opa-domain-contract$": "<rootDir>/../domain-contract/src/index.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
